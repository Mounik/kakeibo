# Flask Configuration
FLASK_APP=app
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-in-production
WTF_CSRF_SECRET_KEY=your-csrf-secret-key-change-in-production

# Database Configuration
# SQLite (default - for development)
DATABASE_URL=sqlite:///data/kakeibo.db
# PostgreSQL (for production)
# DATABASE_URL=postgresql://kakeibo:password@db:5432/kakeibo
# MariaDB/MySQL
# DATABASE_URL=mysql+pymysql://kakeibo:password@db:3306/kakeibo

# Redis Configuration (for Celery)
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Configuration (for password reset, notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=Kakeibo Budget <noreply@kakeibo.local>

# Security
BCRYPT_LOG_ROUNDS=12
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# File Upload
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=data/uploads
ALLOWED_EXTENSIONS=csv,ofx,qif,xlsx,xls

# Pagination
ITEMS_PER_PAGE=20

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/kakeibo.log

# Frontend
BOOTSTRAP_THEME=flatly
CHART_JS_VERSION=4.4.1
HTMX_VERSION=1.9.10
ALPINE_VERSION=3.13.0

# Traefik (for production)
TRAEFIK_DOMAIN=kakeibo.localhost
TRAEFIK_EMAIL=admin@kakeibo.local

# Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=data/backups